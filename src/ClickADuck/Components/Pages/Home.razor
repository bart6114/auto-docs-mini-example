@page "/"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject DuckGameService DuckGame

<PageTitle>Click-a-Duck</PageTitle>

<div class="game-page">
    <section class="game-intro">
        <p class="eyebrow">No ducks were inconvenienced</p>
        <h1>Click-a-Duck</h1>
        <p>Spot a duck. Give it a click. Try to keep up when the whole flock gets involved.</p>
    </section>

    <section class="game-card" aria-labelledby="game-heading">
        <h2 id="game-heading" class="visually-hidden">Duck counting game</h2>

        <div class="scoreboard">
            <div class="score-block" aria-live="polite" aria-atomic="true">
                <span>Score</span>
                <strong>@score</strong>
            </div>
            <div class="rank-block">
                <span>Current rank</span>
                <strong>@CurrentRank.Name</strong>
            </div>
            <div class="game-actions">
                <button class="control-button" type="button" @onclick="TogglePause">
                    @(isPaused ? "Resume" : "Pause")
                </button>
                <button class="control-button control-button--quiet" type="button" @onclick="ResetGame">
                    Reset
                </button>
            </div>
        </div>

        <div class="@PondClass" role="group" aria-label="Duck pond. Click moving birds to score. Swans are worth five points.">
            <div class="sun" aria-hidden="true"></div>
            <div class="cloud cloud--one" aria-hidden="true"></div>
            <div class="cloud cloud--two" aria-hidden="true"></div>
            <div class="reed reed--one" aria-hidden="true"></div>
            <div class="reed reed--two" aria-hidden="true"></div>

            @foreach (var bird in birds)
            {
                <button class="bird @bird.DirectionClass"
                        @key="bird.Id"
                        style="@BirdStyle(bird)"
                        type="button"
                        aria-label="@BirdLabel(bird)"
                        @onclick="() => CountBird(bird.Id)">
                    @if (bird.Kind is BirdKind.Swan)
                    {
                        <span class="bird__visual bird__swan" aria-hidden="true">🦢</span>
                    }
                    else
                    {
                        <img class="bird__visual" src="images/click-a-duck.png" alt="" draggable="false" />
                    }
                </button>
            }

            @if (isPaused)
            {
                <div class="pause-card" role="status">
                    <strong>Pond paused</strong>
                    <span>The ducks are pretending this was their idea.</span>
                </div>
            }

            <div class="water-line" aria-hidden="true"></div>
        </div>

        <div class="game-footer">
            <p>Click every bird you can catch. A rare swan is worth five points.</p>
            <span>@birds.Count bird@(birds.Count == 1 ? "" : "s") on the pond</span>
        </div>
    </section>
</div>

@code {
    private readonly CancellationTokenSource cancellation = new();
    private readonly List<BirdTarget> birds = [];
    private const int SwanOddsDenominator = 10;
    private int score;
    private bool isPaused;
    private Task? spawnLoop;

    private DuckRank CurrentRank => DuckGame.RankFor(score);
    private string PondClass => isPaused ? "pond pond--paused" : "pond";

    protected override void OnInitialized()
    {
        AddBird(startInPond: true);
        AddBird(startInPond: true);
        AddBird(startInPond: true);
        spawnLoop = GrowFlockAsync(cancellation.Token);
    }

    private void CountBird(Guid id)
    {
        if (isPaused)
        {
            return;
        }

        var bird = birds.SingleOrDefault(bird => bird.Id == id);
        if (bird is not null && birds.Remove(bird))
        {
            score = DuckGame.CountBird(score, bird.Kind);
            AddBird();
        }
    }

    private void TogglePause() => isPaused = !isPaused;

    private void ResetGame()
    {
        score = 0;
        isPaused = false;
        birds.Clear();
        AddBird(startInPond: true);
        AddBird(startInPond: true);
        AddBird(startInPond: true);
    }

    private async Task GrowFlockAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                await Task.Delay(DuckGame.SpawnDelayFor(score), cancellationToken);
                await InvokeAsync(() =>
                {
                    if (!isPaused && birds.Count < DuckGame.FlockLimitFor(score))
                    {
                        AddBird();
                        StateHasChanged();
                    }
                });
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    private void AddBird(bool startInPond = false)
    {
        var fromLeft = Random.Shared.Next(2) == 0;
        var duration = Random.Shared.Next(8, 15);
        birds.Add(new BirdTarget(
            Guid.NewGuid(),
            Random.Shared.Next(SwanOddsDenominator) == 0 ? BirdKind.Swan : BirdKind.Duck,
            Random.Shared.Next(8, 72),
            Random.Shared.Next(74, 121),
            duration,
            startInPond ? Random.Shared.Next(-duration + 1, 0) : 0,
            Random.Shared.Next(-7, 8),
            fromLeft ? "bird--from-left" : "bird--from-right"));
    }

    private static string BirdStyle(BirdTarget bird) => FormattableString.Invariant(
        $"--bird-top: {bird.TopPercent}%; --bird-size: {bird.SizePixels}px; --bird-speed: {bird.DurationSeconds}s; --bird-delay: {bird.DelaySeconds}s; --bird-tilt: {bird.TiltDegrees}deg;");

    private static string BirdLabel(BirdTarget bird) => bird.Kind is BirdKind.Swan
        ? "Count this swan for five points"
        : "Count this duck for one point";

    public async ValueTask DisposeAsync()
    {
        await cancellation.CancelAsync();
        if (spawnLoop is not null)
        {
            await spawnLoop;
        }

        cancellation.Dispose();
    }

    private sealed record BirdTarget(
        Guid Id,
        BirdKind Kind,
        int TopPercent,
        int SizePixels,
        int DurationSeconds,
        int DelaySeconds,
        int TiltDegrees,
        string DirectionClass);
}
